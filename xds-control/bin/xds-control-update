#!/usr/bin/env bash
set -Eeuo pipefail

REPO=/opt/XC_VM
BRANCH=agent/xds-control-foundation
ROOT="$REPO/xds-control"
INDEX="$ROOT/public/index.php"

log(){ printf '\n[XDS UPDATE] %s\n' "$*"; }
fail(){ printf '\n[XDS UPDATE ERROR] %s\n' "$*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || fail "Execute como root"
[[ -d "$REPO/.git" ]] || fail "Repositório não encontrado em $REPO"

cd "$REPO"
log "Buscando atualizações do Git"
git fetch origin
log "Atualizando para origin/$BRANCH"
git checkout "$BRANCH" >/dev/null 2>&1 || true
git reset --hard "origin/$BRANCH"

chmod +x "$ROOT/bin"/xds-control-* 2>/dev/null || true

[[ -x "$ROOT/bin/xds-control-enable-line-recovery" ]] || fail "Instalador modular de Linhas ausente"
log "Integrando módulo de Linhas e aplicando migrations"
"$ROOT/bin/xds-control-enable-line-recovery"

log "Validando arquitetura modular"
for FILE in \
  app/LinesModule.php \
  app/Controllers/LinesController.php \
  app/Services/LineService.php \
  app/Repositories/LineRepository.php \
  app/Views/lines/index.php \
  app/Views/lines/form.php \
  app/Views/lines/trash.php \
  app/Views/lines/audit.php
do
  [[ -f "$ROOT/$FILE" ]] || fail "Componente ausente: $FILE"
done

grep -q "LinesModule.php" "$INDEX" || fail "Bridge LinesModule ausente do index.php"
for ROUTE in line-create line-edit line-audit line-delete line-trash line-restore; do
  grep -Rq "$ROUTE" "$ROOT/app" || fail "Rota $ROUTE ausente no módulo"
done

grep -q '/line-trash' "$ROOT/app/Views/lines/index.php" || fail "Botão Lixeira ausente"
grep -q '/line-delete' "$ROOT/app/Views/lines/index.php" || fail "Botão Excluir ausente"
grep -q '/line-restore' "$ROOT/app/Views/lines/trash.php" || fail "Botão Restaurar ausente"

systemctl restart xds-control
sleep 2
HEALTH=$(curl -fsS http://127.0.0.1:9080/health) || {
  journalctl -u xds-control -n 80 --no-pager
  fail "Health check falhou"
}

log "Health OK"
printf '%s\n' "$HEALTH" | python3 -m json.tool 2>/dev/null || printf '%s\n' "$HEALTH"
log "Atualização concluída"
git log -1 --oneline
