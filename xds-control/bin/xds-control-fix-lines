#!/usr/bin/env bash
set -euo pipefail

FILE="/opt/XC_VM/xds-control/public/index.php"
[ -f "$FILE" ] || { echo "Arquivo não encontrado: $FILE" >&2; exit 1; }

BACKUP="${FILE}.before-lines-fix-$(date +%Y%m%d-%H%M%S)"
cp -a "$FILE" "$BACKUP"

echo "[XDS] Backup: $BACKUP"

python3 - <<'PY'
from pathlib import Path
p=Path('/opt/XC_VM/xds-control/public/index.php')
s=p.read_text()
old="""$sql='SELECT l.id,l.username,l.password,l.member_id,l.admin_enabled,l.enabled,l.is_trial,l.is_restreamer,l.max_connections,l.exp_date,l.last_activity,(SELECT COUNT(*) FROM lines_live ll WHERE ll.user_id=l.id) online FROM lines l'.$where.' ORDER BY l.id DESC LIMIT '.$limit;
        $st=$engineDb->prepare($sql);$st->execute($params);$data=$st->fetchAll();"""
new="""$sql='SELECT l.id,l.username,l.password,l.member_id,l.admin_enabled,l.enabled,l.is_trial,l.is_restreamer,l.max_connections,l.exp_date,l.last_activity,COALESCE(o.online,0) online FROM lines l LEFT JOIN (SELECT user_id,COUNT(*) online FROM lines_live GROUP BY user_id) o ON o.user_id=l.id'.$where.' ORDER BY l.id DESC LIMIT '.$limit;
        try {
            $st=$engineDb->prepare($sql);$st->execute($params);$data=$st->fetchAll();
        } catch (Throwable $e) {
            xdsLog('error','Falha na consulta especializada de Linhas',['sql_error'=>$e->getMessage()]);
            $sql='SELECT l.id,l.username,l.password,l.member_id,l.admin_enabled,l.enabled,l.is_trial,l.is_restreamer,l.max_connections,l.exp_date,l.last_activity,0 online FROM lines l'.($q!==''?' WHERE l.username LIKE ? OR l.last_ip LIKE ? OR l.contact LIKE ?':'').' ORDER BY l.id DESC LIMIT '.$limit;
            $st=$engineDb->prepare($sql);$st->execute($params);$data=$st->fetchAll();
        }"""
if old not in s:
    print('[XDS] Bloco exato não encontrado; tentando substituição alternativa.')
    old2="(SELECT COUNT(*) FROM lines_live ll WHERE ll.user_id=l.id) online"
    if old2 not in s:
        raise SystemExit('Não encontrei a consulta de Linhas para corrigir.')
    s=s.replace(old2,"COALESCE(o.online,0) online",1)
    s=s.replace(" FROM lines l'.$where.' ORDER BY l.id DESC LIMIT '.$limit;"," FROM lines l LEFT JOIN (SELECT user_id,COUNT(*) online FROM lines_live GROUP BY user_id) o ON o.user_id=l.id'.$where.' ORDER BY l.id DESC LIMIT '.$limit;",1)
else:
    s=s.replace(old,new,1)
p.write_text(s)
PY

systemctl restart xds-control
sleep 2

echo "[XDS] Health:"
curl -fsS http://127.0.0.1:9080/health || true
echo

echo "[XDS] Últimos erros:"
tail -n 20 /opt/XC_VM/xds-control/storage/logs/xds-control.log || true
